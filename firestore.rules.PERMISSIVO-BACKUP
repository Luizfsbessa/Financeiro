// ============================================================
// firestore.rules
// Regras TEMPORÁRIAS para a fase de desenvolvimento: qualquer
// usuário autenticado (logado com Google) pode ler e escrever em
// qualquer coleção. Isso é intencionalmente simples para não travar
// o desenvolvimento agora — mas precisa ser refinado antes de usar
// com o condomínio de verdade.
//
// COMO APLICAR:
// Console do Firebase → Firestore Database → aba "Regras" → cole
// este conteúdo inteiro no lugar do que já estiver lá → "Publicar".
//
// PRÓXIMA ITERAÇÃO (papéis diferenciados):
//   - Qualquer usuário autenticado: pode CRIAR lançamentos, mas não editar/apagar os de outros
//   - Apenas um papel "gestor" (ex.: lista de e-mails ou custom claim): pode editar orçamento aprovado/projetado
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
